# AI Shield mobile configuration. Copy to "mobile/.env" and fill in.
# EXPO_PUBLIC_* values are bundled into the app, so they must NEVER be secrets.
# The Gemini API key belongs only in the backend's .env, never here.

# Backend address reachable from the phone. Use your PC's Wi-Fi IP address (run `ipconfig`),
# not "localhost", when testing on a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# OAuth 2.0 "Web application" client ID (same value as GOOGLE_OAUTH_WEB_CLIENT_ID in the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional, iOS only. Not needed for Android.
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx
