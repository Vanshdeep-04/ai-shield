# AI Shield configuration template.
# Copy this file to ".env" in the same folder and fill in your own values.
# ".env" is git-ignored. Never commit real keys, passwords or client secrets.

# ---------------------------------------------------------------------------
# Gemini Developer API (server-side only; never put this key in the mobile app)
# Create a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Free-tier model verified in Google's docs on 2026-11-19. Change only to another model
# that your project can use; AI Shield never switches models automatically.
GEMINI_MODEL=gemini-3.5-flash-lite
# Header used in Google's Interactions API REST examples. Leave empty to omit it.
GEMINI_API_REVISION=2026-05-20

# ---------------------------------------------------------------------------
# MySQL 8 (create the database and user with backend/db/mysql-setup.sql)
# allowPublicKeyRetrieval/useSSL=false are for a local server only; use TLS for a remote one.
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/aishield?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8
DB_USERNAME=aishield
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Authentication
#   google = production mode: the app must send a Google ID token (recommended)
#   dev    = local testing with Postman/curl only; everyone is one demo user
# ---------------------------------------------------------------------------
AISHIELD_AUTH_MODE=dev
# OAuth 2.0 "Web application" client ID from Google Cloud (ends in .apps.googleusercontent.com).
# Required when AISHIELD_AUTH_MODE=google. This is an ID, not a secret.
GOOGLE_OAUTH_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
PORT=8080
# Max analyses per user per minute (protects the free-tier Gemini quota)
AISHIELD_ANALYSIS_RPM=8
# Browser origins allowed by CORS (only needed for web-based tools)
AISHIELD_CORS_ORIGINS=http://localhost:8081
